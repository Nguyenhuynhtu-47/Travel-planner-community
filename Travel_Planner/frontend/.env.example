# ==============================================================================
# TRAVEL PLANNER - FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Public frontend configurations only.
# Used for compiling / running Flutter Mobile and Flutter Web.
# Pass via `--dart-define` or `--dart-define-from-file=.env`.
#
# IMPORTANT:
# NEVER place server-side secrets (JWT_SECRET, DB_PASSWORD, CLOUDINARY_API_SECRET,
# LOCATION_IQ_API_KEY, OPENROUTESERVICE_API_KEY) in this file.
# Any value embedded in Flutter client builds is visible to end users.
# ==============================================================================

# Backend API Base URL
# - Physical Android device: http://<YOUR_LAN_IP>:8080 (or localhost with adb reverse tcp:8080 tcp:8080)
# - Android Emulator: http://10.0.2.2:8080
# - Flutter Web / iOS: http://localhost:8080
API_BASE_URL=http://localhost:8080

# CARTO Basemaps Raster Tile Key (Public client-side map tile key)
# Register free non-commercial key at: https://carto.com/basemaps/apikey
CARTO_API_KEY=your_carto_basemaps_api_key_here
MAP_API_KEY=your_carto_basemaps_api_key_here

